<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="cinema"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>fr.diginamic.cinema.entite.Film</class>
        <class>fr.diginamic.cinema.entite.Personne</class>
        <class>fr.diginamic.cinema.entite.Acteur</class>
        <class>fr.diginamic.cinema.entite.Realisateur</class>
        <class>fr.diginamic.cinema.entite.Role</class>
        <class>fr.diginamic.cinema.entite.Genre</class>
        <class>fr.diginamic.cinema.entite.Langue</class>
        <class>fr.diginamic.cinema.entite.Pays</class>
        <class>fr.diginamic.cinema.entite.LieuNaissance</class>
        <class>fr.diginamic.cinema.entite.LieuTournage</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.mariadb.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mariadb://localhost:3306/cinema"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value=""/>

            <property name="jakarta.persistence.schema-generation.database.action"
                      value="drop-and-create"/>

            <property name="hibernate.connection.useUnicode"
                      value="true"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

            <property name="hibernate.highlight_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>